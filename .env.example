APP_NAME="Perkap Pramuka"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=perkap_pramuka
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@perkap-pramuka.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Pengaturan Perkap Pramuka (semua opsional; nilai di bawah = bawaan)
# ---------------------------------------------------------------------------
# Kontak WhatsApp petugas (tampil di pesan akun diblokir / batas pendaftaran)
PERKAP_WA=085877708909
# Awalan ID Anggota (2-6 huruf), mis. PRK-26-K7M2QH-9
PERKAP_PREFIX_ID=PRK
# Batas pendaftaran akun dari satu IP dalam jendela waktu bergulir
PERKAP_BATAS_DAFTAR_PER_IP=3
PERKAP_JENDELA_DAFTAR_JAM=24
# IP / blok CIDR yang bebas dari batas pendaftaran, pisahkan dengan koma.
# Wi-Fi sekolah = SATU IP publik untuk semua siswa: isi di sini saat pendaftaran massal,
# atau naikkan PERKAP_BATAS_DAFTAR_PER_IP sementara. Contoh: 203.0.113.10,198.51.100.0/24
# Saat uji di komputer sendiri (php artisan serve), isi 127.0.0.1,::1 supaya tidak terkena batas (lalu: php artisan config:clear).
PERKAP_IP_DIKECUALIKAN=
# Batas percobaan kirim formulir daftar per IP per jam (anti bot/spam)
PERKAP_BATAS_PERCOBAAN_DAFTAR=20
# Jumlah catatan "penipuan" yang membuat akun ditandai layak diblokir (blokir tetap keputusan petugas)
PERKAP_BATAS_PENIPUAN=3
# Tampilkan petunjuk "php artisan migrate" bila ada migrasi tertunda
PERKAP_PERIKSA_MIGRASI=true
# Hanya bila aplikasi berada di belakang proxy/CDN/Cloudflare: percayai header X-Forwarded-For
# agar IP pengunjung terbaca benar (daftar IP proxy dipisah koma). Hindari "*" bila server juga bisa
# diakses langsung, karena header palsu bisa menyiasati batas per IP. Kosongkan bila tidak memakai proxy.
TRUSTED_PROXIES=
